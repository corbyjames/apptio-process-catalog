      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_07_3" name="Report cloud cost, unit economics &amp; sustainability" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 07.3.1. 4 processes: 07.3.1, 07.3.2, 07.3.3, 07.3.4</bpmn:documentation>
