<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G04_3" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G04_3">
    <bpmn:participant id="Participant_G04_3" name="04.3 Allocate resources &amp; track utilization — Allocate resources &amp; track utilization" processRef="Process_G04_3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G04_3" name="Allocate resources &amp; track utilization" isExecutable="false">
    <bpmn:documentation>Process group 04.3 in L0-04 Workforce &amp; Resource Management: 4 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G04_3">
      <bpmn:lane id="Lane_G04_3_0" name="Resource Management">
        <bpmn:flowNodeRef>n_04_3_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_04_3_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_04_3_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G04_3_1" name="Portfolio Management">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_04_3_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_04_3_1" name="Allocate people &amp; teams to work">
      <bpmn:documentation>Catalog: 04.3.1. Outcome: work allocations (bottom-up demand)</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_04_3_2" name="Track utilization &amp; productivity">
      <bpmn:documentation>Catalog: 04.3.2. Outcome: utilization &amp; efficiency reports</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_04_3_3" name="Match skills &amp; close gaps">
      <bpmn:documentation>Catalog: 04.3.3. Outcome: gap analysis, hiring/upskill plan</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_04_3_4" name="Assign individuals &amp; roles to project work (hybrid resourcing)">
      <bpmn:documentation>Catalog: 04.3.4. Outcome: individual/role assignments in the same capacity model</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_04_3_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_04_3_1" targetRef="n_04_3_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_04_3_2" targetRef="n_04_3_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_04_3_3" targetRef="n_04_3_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_04_3_4" targetRef="n_end_implicit" />
  </bpmn:process>
