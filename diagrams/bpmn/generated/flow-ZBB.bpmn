      <bpmndi:BPMNShape id="n_z8_di" bpmnElement="n_z8"><dc:Bounds x="1842" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_z9_di" bpmnElement="n_z9"><dc:Bounds x="2050" y="390" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_z10_di" bpmnElement="n_z10"><dc:Bounds x="2258" y="146" width="162" height="74" /></bpmndi:BPMNShape>
