<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G05_2" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G05_2">
    <bpmn:participant id="Participant_G05_2" name="05.2 Forecast on a rolling cadence — Forecast on a rolling cadence" processRef="Process_G05_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G05_2" name="Forecast on a rolling cadence" isExecutable="false">
    <bpmn:documentation>Process group 05.2 in L0-05 IT Financial Planning &amp; Budgeting: 4 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G05_2">
      <bpmn:lane id="Lane_G05_2_0" name="IT Finance">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_05_2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_05_2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_05_2_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G05_2_1" name="Budget Owners">
        <bpmn:flowNodeRef>n_05_2_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="n_05_2_1" name="Create forecast seeded with actuals">
      <bpmn:documentation>Catalog: 05.2.1. Outcome: forecast version</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="n_05_2_2" name="Update forecasts (driver &amp; AI-assisted)">
      <bpmn:documentation>Catalog: 05.2.2. Outcome: updated forecast</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_05_2_3" name="Model what-if scenarios">
      <bpmn:documentation>Catalog: 05.2.3. Outcome: scenario comparisons</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="n_05_2_4" name="Submit &amp; sign off forecast">
      <bpmn:documentation>Catalog: 05.2.4. Outcome: approved forecast of record</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_05_2_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_05_2_1" targetRef="n_05_2_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_05_2_2" targetRef="n_05_2_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_05_2_3" targetRef="n_05_2_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_05_2_4" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G05_2">
    <bpmndi:BPMNPlane id="BPMNPlane_G05_2" bpmnElement="Collaboration_G05_2">
