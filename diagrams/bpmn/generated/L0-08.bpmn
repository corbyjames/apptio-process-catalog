  <bpmn:process id="Process_A08" name="Consumption, Chargeback &amp; Value Management" isExecutable="false">
    <bpmn:documentation>Turn transparency into accountability: showback and Bill of IT to business units, price services, shape demand, benchmark against peers, and run the executive value operating rhythm.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_A08">
      <bpmn:lane id="Lane_A08_0" name="TBM Office">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_08_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_08_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="n_08_1" name="Show back &amp; bill for IT" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 08.1.1. 3 processes: 08.1.1, 08.1.2, 08.1.3</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_08_2" name="Engage the business &amp; steer value" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 08.2.1. 3 processes: 08.2.1, 08.2.2, 08.2.3</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_08_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_08_1" targetRef="n_08_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_08_2" targetRef="n_end_implicit" />
  </bpmn:process>
