  <bpmn:collaboration id="Collaboration_A01">
    <bpmn:participant id="Participant_A01" name="L0-01 Strategy &amp; Goal Management — Strategy &amp; Goal Management" processRef="Process_A01" />
  </bpmn:collaboration>
  <bpmn:process id="Process_A01" name="Strategy &amp; Goal Management" isExecutable="false">
    <bpmn:documentation>Define enterprise strategy and cascade it as measurable objectives so every portfolio, program and team has line of sight from work to strategic intent.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_A01">
      <bpmn:lane id="Lane_A01_0" name="C-Suite/Strategy">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_01_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_01_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="n_01_1" name="Set strategic direction &amp; alignment" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 01.1.1. 3 processes: 01.1.1, 01.1.2, 01.1.3</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_01_2" name="Manage OKRs" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 01.2.1. 3 processes: 01.2.1, 01.2.2, 01.2.3</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_01_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_01_1" targetRef="n_01_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_01_2" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_A01">
