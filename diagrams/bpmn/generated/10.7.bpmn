<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G10_7" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.7.0">
  <bpmn:collaboration id="Collaboration_G10_7">
    <bpmn:participant id="Participant_G10_7" name="10.7 Run AI-assisted planning &amp; delivery intelligence — Run AI-assisted planning &amp; delivery intelligence" processRef="Process_G10_7" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G10_7" name="Run AI-assisted planning &amp; delivery intelligence" isExecutable="false">
    <bpmn:documentation>Process group 10.7 in L0-10 Platform Configuration, Data &amp; Administration: 3 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G10_7">
      <bpmn:lane id="Lane_G10_7_0" name="Platform Admins">
        <bpmn:flowNodeRef>n_10_7_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G10_7_1" name="SPM Governance">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_7_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_7_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_10_7_1" name="Deploy the planning copilot &amp; delivery intelligence">
      <bpmn:documentation>Catalog: 10.7.1. Outcome: readiness scores, dependency heatmaps, briefings, scenario analyses</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_10_7_2" name="Govern agent autonomy &amp; trust">
      <bpmn:documentation>Catalog: 10.7.2. Outcome: configured autonomy rules, audit trail</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_10_7_3" name="Ground agents in enterprise context &amp; ecosystem">
      <bpmn:documentation>Catalog: 10.7.3. Outcome: version-controlled agent knowledge &amp; integrations</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_10_7_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_10_7_1" targetRef="n_10_7_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_10_7_2" targetRef="n_10_7_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_10_7_3" targetRef="n_end_implicit" />
  </bpmn:process>
