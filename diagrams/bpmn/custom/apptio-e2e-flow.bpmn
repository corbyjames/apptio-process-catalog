<bpmn:sequenceFlow id="flow_12" sourceRef="t_rates" targetRef="t_send4" />
<bpmn:sequenceFlow id="flow_13" name="ADM" sourceRef="t_send4" targetRef="t_costwa" />
<bpmn:sequenceFlow id="flow_14" sourceRef="t_costwa" targetRef="t_data" />
<bpmn:sequenceFlow id="flow_15" sourceRef="t_data" targetRef="t_send3" />
<bpmn:sequenceFlow id="flow_16" name="ADM" sourceRef="t_send3" targetRef="t_calc" />
<bpmn:sequenceFlow id="flow_17" sourceRef="t_calc" targetRef="g_vis" />
<bpmn:sequenceFlow id="flow_18" sourceRef="g_vis" targetRef="t_work" name="Yes" />
<bpmn:sequenceFlow id="flow_19" sourceRef="g_vis" targetRef="t_tower" name="No" />
<bpmn:sequenceFlow id="flow_20" sourceRef="t_work" targetRef="g_join" />
<bpmn:sequenceFlow id="flow_21" sourceRef="t_tower" targetRef="g_join" />
<bpmn:sequenceFlow id="flow_22" sourceRef="g_join" targetRef="t_sap" />
<bpmn:sequenceFlow id="flow_23" sourceRef="t_sap" targetRef="t_tco" />
<bpmn:sequenceFlow id="flow_24" sourceRef="t_tco" targetRef="t_run" />
<bpmn:sequenceFlow id="flow_25" sourceRef="t_run" targetRef="end1" />
</bpmn:process>
