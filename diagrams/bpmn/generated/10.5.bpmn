<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G10_5" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.7.0">
  <bpmn:collaboration id="Collaboration_G10_5">
    <bpmn:participant id="Participant_G10_5" name="10.5 Operate cross-product data &amp; integrations — Operate cross-product data &amp; integrations" processRef="Process_G10_5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G10_5" name="Operate cross-product data &amp; integrations" isExecutable="false">
    <bpmn:documentation>Process group 10.5 in L0-10 Platform Configuration, Data &amp; Administration: 2 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G10_5">
      <bpmn:lane id="Lane_G10_5_0" name="TBM Office">
        <bpmn:flowNodeRef>n_10_5_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G10_5_1" name="Integration Team">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_5_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_10_5_1" name="Operate the ADM data highway">
      <bpmn:documentation>Catalog: 10.5.1. Outcome: reliable cross-tool flows</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_10_5_2" name="Govern master data &amp; taxonomy">
      <bpmn:documentation>Catalog: 10.5.2. Outcome: consistent shared taxonomy</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_10_5_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_10_5_1" targetRef="n_10_5_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_10_5_2" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G10_5">
    <bpmndi:BPMNPlane id="BPMNPlane_G10_5" bpmnElement="Collaboration_G10_5">
      <bpmndi:BPMNShape id="Participant_G10_5_di" bpmnElement="Participant_G10_5" isHorizontal="true"><dc:Bounds x="0" y="0" width="1010" height="244" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G10_5_0_di" bpmnElement="Lane_G10_5_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="980" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G10_5_1_di" bpmnElement="Lane_G10_5_1" isHorizontal="true"><dc:Bounds x="30" y="122" width="980" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_implicit_di" bpmnElement="n_start_implicit"><dc:Bounds x="241" y="165" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_10_5_1_di" bpmnElement="n_10_5_1"><dc:Bounds x="386" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_10_5_2_di" bpmnElement="n_10_5_2"><dc:Bounds x="594" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_implicit_di" bpmnElement="n_end_implicit"><dc:Bounds x="865" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="277" y="183" /><di:waypoint x="386" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="548" y="183" /><di:waypoint x="571" y="183" /><di:waypoint x="571" y="61" /><di:waypoint x="594" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="756" y="61" /><di:waypoint x="865" y="61" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
