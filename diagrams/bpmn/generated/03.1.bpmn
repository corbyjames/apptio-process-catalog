<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G03_1" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.7.0">
  <bpmn:collaboration id="Collaboration_G03_1">
    <bpmn:participant id="Participant_G03_1" name="03.1 Plan quarterly (SAFe PI cadence) — Plan quarterly (SAFe PI cadence)" processRef="Process_G03_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G03_1" name="Plan quarterly (SAFe PI cadence)" isExecutable="false">
    <bpmn:documentation>Process group 03.1 in L0-03 Agile Program &amp; Delivery Management: 6 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G03_1">
      <bpmn:lane id="Lane_G03_1_0" name="RTE/Program">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_1_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_1_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_1_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G03_1_1" name="Agile Teams">
        <bpmn:flowNodeRef>n_03_1_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_1_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_03_1_1" name="Assess &amp; prepare quarterly planning readiness">
      <bpmn:documentation>Catalog: 03.1.1. Outcome: rEADY verdict, prepared backlog &amp; objectives</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_03_1_2" name="Run quarterly planning event">
      <bpmn:documentation>Catalog: 03.1.2. Outcome: draft team plans, dependency board</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="n_03_1_3" name="Commit &amp; publish PI objectives">
      <bpmn:documentation>Catalog: 03.1.3. Outcome: committed PI objectives &amp; program board</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="n_03_1_4" name="Baseline commitments &amp; track PI execution">
      <bpmn:documentation>Catalog: 03.1.4. Outcome: progress/flow reporting, I&amp;A actions</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_03_1_5" name="Manage PI risks (ROAM) &amp; confidence vote">
      <bpmn:documentation>Catalog: 03.1.5. Outcome: rOAMed risk register, confidence results &amp; remediation actions</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_03_1_6" name="Run system demo &amp; Inspect and Adapt">
      <bpmn:documentation>Catalog: 03.1.6. Outcome: demo, I&amp;A findings, improvement backlog</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_03_1_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_03_1_1" targetRef="n_03_1_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_03_1_2" targetRef="n_03_1_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_03_1_3" targetRef="n_03_1_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_03_1_4" targetRef="n_03_1_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="n_03_1_5" targetRef="n_03_1_6" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="n_03_1_6" targetRef="n_end_implicit" />
  </bpmn:process>
