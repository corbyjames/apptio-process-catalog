  <bpmn:collaboration id="Collaboration_G06_5">
    <bpmn:participant id="Participant_G06_5" name="06.5 Manage vendor &amp; asset cost — Manage vendor &amp; asset cost" processRef="Process_G06_5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G06_5" name="Manage vendor &amp; asset cost" isExecutable="false">
    <bpmn:documentation>Process group 06.5 in L0-06 Cost Transparency &amp; TBM Operations: 2 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G06_5">
      <bpmn:lane id="Lane_G06_5_0" name="TBM Office/IT Finance">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_5_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_5_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_06_5_1" name="Consolidate &amp; analyze vendor spend">
      <bpmn:documentation>Catalog: 06.5.1. Outcome: vendor insights &amp; actions</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_06_5_2" name="Track assets &amp; depreciation">
      <bpmn:documentation>Catalog: 06.5.2. Outcome: asset cost &amp; depreciation in model</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_06_5_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_06_5_1" targetRef="n_06_5_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_06_5_2" targetRef="n_end_implicit" />
  </bpmn:process>
