<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G08_2" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G08_2">
    <bpmn:participant id="Participant_G08_2" name="08.2 Engage the business &amp; steer value — Engage the business &amp; steer value" processRef="Process_G08_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G08_2" name="Engage the business &amp; steer value" isExecutable="false">
    <bpmn:documentation>Process group 08.2 in L0-08 Consumption, Chargeback &amp; Value Management: 3 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G08_2">
      <bpmn:lane id="Lane_G08_2_0" name="TBM Office">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_08_2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_08_2_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G08_2_1" name="CIO/CFO">
        <bpmn:flowNodeRef>n_08_2_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="n_08_2_1" name="Review costs with BU owners">
      <bpmn:documentation>Catalog: 08.2.1. Outcome: demand decisions, behavior change</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="n_08_2_2" name="Extend costing beyond IT">
      <bpmn:documentation>Catalog: 08.2.2. Outcome: business process/product TCO</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_08_2_3" name="Run the CIO monthly operations review">
      <bpmn:documentation>Catalog: 08.2.3. Outcome: executive decisions &amp; actions</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_08_2_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_08_2_1" targetRef="n_08_2_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_08_2_2" targetRef="n_08_2_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_08_2_3" targetRef="n_end_implicit" />
  </bpmn:process>
