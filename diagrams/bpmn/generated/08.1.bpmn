<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G08_1" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G08_1">
    <bpmn:participant id="Participant_G08_1" name="08.1 Show back &amp; bill for IT — Show back &amp; bill for IT" processRef="Process_G08_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G08_1" name="Show back &amp; bill for IT" isExecutable="false">
    <bpmn:documentation>Process group 08.1 in L0-08 Consumption, Chargeback &amp; Value Management: 3 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G08_1">
      <bpmn:lane id="Lane_G08_1_0" name="TBM Office">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_08_1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_08_1_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_08_1_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_08_1_1" name="Allocate consumption to business units">
      <bpmn:documentation>Catalog: 08.1.1. Outcome: bU consumption costs</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="n_08_1_2" name="Publish showback / Bill of IT">
      <bpmn:documentation>Catalog: 08.1.2. Outcome: bill of IT statements</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_08_1_3" name="Price services &amp; run chargeback">
      <bpmn:documentation>Catalog: 08.1.3. Outcome: chargeback invoices, recovery position</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_08_1_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_08_1_1" targetRef="n_08_1_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_08_1_2" targetRef="n_08_1_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_08_1_3" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G08_1">
    <bpmndi:BPMNPlane id="BPMNPlane_G08_1" bpmnElement="Collaboration_G08_1">
      <bpmndi:BPMNShape id="Participant_G08_1_di" bpmnElement="Participant_G08_1" isHorizontal="true"><dc:Bounds x="0" y="0" width="1218" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G08_1_0_di" bpmnElement="Lane_G08_1_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="1188" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_implicit_di" bpmnElement="n_start_implicit"><dc:Bounds x="241" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_08_1_1_di" bpmnElement="n_08_1_1"><dc:Bounds x="386" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_08_1_2_di" bpmnElement="n_08_1_2"><dc:Bounds x="594" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_08_1_3_di" bpmnElement="n_08_1_3"><dc:Bounds x="802" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_implicit_di" bpmnElement="n_end_implicit"><dc:Bounds x="1073" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="277" y="61" /><di:waypoint x="386" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="548" y="61" /><di:waypoint x="594" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="756" y="61" /><di:waypoint x="802" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="964" y="61" /><di:waypoint x="1073" y="61" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
