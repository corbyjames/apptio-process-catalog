<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UC3" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_UC3">
    <bpmn:participant id="Participant_UC3" name="Targets down — Portfolio target spend" processRef="Process_UC3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_UC3" name="Portfolio target spend" isExecutable="false">
    <bpmn:documentation>Finance builds workforce plans and top-down target spend in Planning; targets ride the data highway to Targetprocess as budget artifacts; portfolio allocates teams to work and compares bottom-up demand to targets; position requests round-trip through approval back into the plan.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_UC3">
      <bpmn:lane id="Lane_UC3_0" name="IT Planning (Finance)">
        <bpmn:flowNodeRef>n_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_UC3_1" name="Targetprocess / ATP">
        <bpmn:flowNodeRef>n_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_6_no</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start" name="Planning cycle begins">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_1" name="Create workforce plan &amp; top-down target spend by department">
      <bpmn:documentation>Catalog: 05.1.2, 05.4.1. At whatever level you budget: department, cost center, ART, solution train</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_2" name="Send portfolio spend targets to Targetprocess (data highway)">
      <bpmn:documentation>Catalog: 05.1.2, 10.5.1. Lane crossing: ADM</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_3" name="Create top-down budget / target artifacts">
      <bpmn:documentation>Catalog: 02.4.2. </bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="n_4" name="Create position request (role, location, hours, type)">
      <bpmn:documentation>Catalog: 04.4.1. Department link ties request to finance budget line</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_5" name="Run multi-level approval workflow (HR &gt; Dept &gt; Final, escalations)">
      <bpmn:documentation>Catalog: 04.4.2. </bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="n_6" name="Approved?">
      <bpmn:documentation>Catalog: 04.4.2. No: end event &#x27;Request rejected&#x27;; Yes: continue</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="n_6_no" name="Request rejected">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="n_7" name="Send approved positions to IT Planning (daily / weekly sync)">
      <bpmn:documentation>Catalog: 04.4.3. Only approved positions cross</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:task id="n_8" name="Normalize &amp; budget open + filled positions (auto-updated when filled)">
      <bpmn:documentation>Catalog: 05.4.1, 04.4.3. Round-trip: fill event in ATP auto-updates Planning record</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="n_9" name="Allocate users / teams / ARTs / solution trains to work (bottom-up demand)">
      <bpmn:documentation>Catalog: 04.3.1. </bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="n_10" name="Compare demand rollup vs. target spend (capacity / FTE reports)">
      <bpmn:documentation>Catalog: 04.2.2, 02.4.3. Forward-looking: e.g. 3 months out demand exceeds FTE</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start" targetRef="n_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_1" targetRef="n_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_2" targetRef="n_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_3" targetRef="n_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_4" targetRef="n_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="n_5" targetRef="n_6" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="n_6" targetRef="n_6_no" name="No" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="n_6" targetRef="n_7" name="Yes" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="n_7" targetRef="n_8" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="n_8" targetRef="n_9" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="n_9" targetRef="n_10" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="n_10" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_UC3">
    <bpmndi:BPMNPlane id="BPMNPlane_UC3" bpmnElement="Collaboration_UC3">
      <bpmndi:BPMNShape id="Participant_UC3_di" bpmnElement="Participant_UC3" isHorizontal="true"><dc:Bounds x="0" y="0" width="2674" height="340" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_UC3_0_di" bpmnElement="Lane_UC3_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="2644" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_UC3_1_di" bpmnElement="Lane_UC3_1" isHorizontal="true"><dc:Bounds x="30" y="122" width="2644" height="218" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_di" bpmnElement="n_start"><dc:Bounds x="241" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_1_di" bpmnElement="n_1"><dc:Bounds x="386" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_2_di" bpmnElement="n_2"><dc:Bounds x="594" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_3_di" bpmnElement="n_3"><dc:Bounds x="802" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_4_di" bpmnElement="n_4"><dc:Bounds x="1010" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_5_di" bpmnElement="n_5"><dc:Bounds x="1218" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_6_di" bpmnElement="n_6"><dc:Bounds x="1483" y="159" width="48" height="48" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_6_no_di" bpmnElement="n_6_no"><dc:Bounds x="1489" y="261" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_7_di" bpmnElement="n_7"><dc:Bounds x="1634" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_8_di" bpmnElement="n_8"><dc:Bounds x="1842" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_9_di" bpmnElement="n_9"><dc:Bounds x="2050" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_10_di" bpmnElement="n_10"><dc:Bounds x="2258" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_implicit_di" bpmnElement="n_end_implicit"><dc:Bounds x="2529" y="165" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="277" y="61" /><di:waypoint x="386" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="548" y="61" /><di:waypoint x="594" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="756" y="61" /><di:waypoint x="779" y="61" /><di:waypoint x="779" y="183" /><di:waypoint x="802" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="964" y="183" /><di:waypoint x="1010" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="1172" y="183" /><di:waypoint x="1218" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1380" y="183" /><di:waypoint x="1483" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1507" y="207" /><di:waypoint x="1507" y="261" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1531" y="183" /><di:waypoint x="1634" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1796" y="183" /><di:waypoint x="1819" y="183" /><di:waypoint x="1819" y="61" /><di:waypoint x="1842" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9"><di:waypoint x="2004" y="61" /><di:waypoint x="2027" y="61" /><di:waypoint x="2027" y="183" /><di:waypoint x="2050" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="2212" y="183" /><di:waypoint x="2258" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="2420" y="183" /><di:waypoint x="2529" y="183" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
