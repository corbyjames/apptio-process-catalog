<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G07_5" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G07_5">
    <bpmn:participant id="Participant_G07_5" name="07.5 Optimize usage &amp; rates — Optimize usage &amp; rates" processRef="Process_G07_5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G07_5" name="Optimize usage &amp; rates" isExecutable="false">
    <bpmn:documentation>Process group 07.5 in L0-07 Cloud Financial Management (FinOps): 4 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G07_5">
      <bpmn:lane id="Lane_G07_5_0" name="FinOps Practitioner">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_07_5_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_07_5_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_07_5_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_07_5_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_07_5_1" name="Run the rightsizing cadence">
      <bpmn:documentation>Catalog: 07.5.1. Outcome: actioned rightsizing, ROI</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_07_5_2" name="Eliminate waste &amp; govern pre-deployment">
      <bpmn:documentation>Catalog: 07.5.2. Outcome: waste removal, policy compliance</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_07_5_3" name="Manage commitments (assisted)">
      <bpmn:documentation>Catalog: 07.5.3. Outcome: commitment purchases &amp; coverage</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_07_5_4" name="Automate commitments (Savings Automation)">
      <bpmn:documentation>Catalog: 07.5.4. Outcome: automated RI/SP portfolio &amp; savings</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_07_5_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_07_5_1" targetRef="n_07_5_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_07_5_2" targetRef="n_07_5_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_07_5_3" targetRef="n_07_5_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_07_5_4" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G07_5">
    <bpmndi:BPMNPlane id="BPMNPlane_G07_5" bpmnElement="Collaboration_G07_5">
