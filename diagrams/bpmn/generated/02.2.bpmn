<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G02_2" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G02_2">
    <bpmn:participant id="Participant_G02_2" name="02.2 Prioritize &amp; decide investments — Prioritize &amp; decide investments" processRef="Process_G02_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G02_2" name="Prioritize &amp; decide investments" isExecutable="false">
    <bpmn:documentation>Process group 02.2 in L0-02 Demand &amp; Portfolio Investment Management: 3 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G02_2">
      <bpmn:lane id="Lane_G02_2_0" name="Portfolio Management">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_02_2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_02_2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_02_2_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="n_02_2_1" name="Build lean business case / epic hypothesis">
      <bpmn:documentation>Catalog: 02.2.1. Outcome: lean business cases with estimates</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_02_2_2" name="Prioritize by value (WSJF / scoring)">
      <bpmn:documentation>Catalog: 02.2.2. Outcome: ranked backlog</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_02_2_3" name="Approve &amp; fund investments">
      <bpmn:documentation>Catalog: 02.2.3. Outcome: funded investments/epics</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_02_2_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_02_2_1" targetRef="n_02_2_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_02_2_2" targetRef="n_02_2_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_02_2_3" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G02_2">
    <bpmndi:BPMNPlane id="BPMNPlane_G02_2" bpmnElement="Collaboration_G02_2">
      <bpmndi:BPMNShape id="Participant_G02_2_di" bpmnElement="Participant_G02_2" isHorizontal="true"><dc:Bounds x="0" y="0" width="1218" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G02_2_0_di" bpmnElement="Lane_G02_2_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="1188" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_implicit_di" bpmnElement="n_start_implicit"><dc:Bounds x="241" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_02_2_1_di" bpmnElement="n_02_2_1"><dc:Bounds x="386" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_02_2_2_di" bpmnElement="n_02_2_2"><dc:Bounds x="594" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_02_2_3_di" bpmnElement="n_02_2_3"><dc:Bounds x="802" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_implicit_di" bpmnElement="n_end_implicit"><dc:Bounds x="1073" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="277" y="61" /><di:waypoint x="386" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="548" y="61" /><di:waypoint x="594" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="756" y="61" /><di:waypoint x="802" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="964" y="61" /><di:waypoint x="1073" y="61" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
