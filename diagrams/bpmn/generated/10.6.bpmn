  <bpmn:collaboration id="Collaboration_G10_6">
    <bpmn:participant id="Participant_G10_6" name="10.6 Run the practices &amp; grow maturity — Run the practices &amp; grow maturity" processRef="Process_G10_6" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G10_6" name="Run the practices &amp; grow maturity" isExecutable="false">
    <bpmn:documentation>Process group 10.6 in L0-10 Platform Configuration, Data &amp; Administration: 4 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G10_6">
      <bpmn:lane id="Lane_G10_6_0" name="TBM Office">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_6_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_6_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G10_6_1" name="FinOps Team">
        <bpmn:flowNodeRef>n_10_6_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G10_6_2" name="SPM Governance">
        <bpmn:flowNodeRef>n_10_6_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_10_6_1" name="Run the TBM office">
      <bpmn:documentation>Catalog: 10.6.1. Outcome: sustained TBM practice</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_10_6_2" name="Run the FinOps practice">
      <bpmn:documentation>Catalog: 10.6.2. Outcome: sustained FinOps practice</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_10_6_3" name="Run SPM governance &amp; transformation">
      <bpmn:documentation>Catalog: 10.6.3. Outcome: advancing SPM maturity</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_10_6_4" name="Assess maturity &amp; set roadmap">
      <bpmn:documentation>Catalog: 10.6.4. Outcome: scores, gaps, roadmap</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_10_6_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_10_6_1" targetRef="n_10_6_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_10_6_2" targetRef="n_10_6_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_10_6_3" targetRef="n_10_6_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_10_6_4" targetRef="n_end_implicit" />
  </bpmn:process>
