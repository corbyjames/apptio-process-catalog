  <bpmn:collaboration id="Collaboration_G06_4">
    <bpmn:participant id="Participant_G06_4" name="06.4 Cost labor &amp; capitalize — Cost labor &amp; capitalize" processRef="Process_G06_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G06_4" name="Cost labor &amp; capitalize" isExecutable="false">
    <bpmn:documentation>Process group 06.4 in L0-06 Cost Transparency &amp; TBM Operations: 6 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G06_4">
      <bpmn:lane id="Lane_G06_4_0" name="TBM Office/IT Finance">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_4_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_4_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_4_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_4_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G06_4_1" name="Costing Admin">
        <bpmn:flowNodeRef>n_06_4_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_4_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_06_4_1" name="Maintain protected rates &amp; compute blended rates">
      <bpmn:documentation>Catalog: 06.4.1. Outcome: blended rates by team/ART</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_06_4_2" name="Publish blended rates to Targetprocess">
      <bpmn:documentation>Catalog: 06.4.2. Outcome: rates available in ATP</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_06_4_3" name="Ingest workforce &amp; completed work data">
      <bpmn:documentation>Catalog: 06.4.3. Outcome: labor model inputs</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_06_4_4" name="Compute monthly team cost &amp; blended CapEx %">
      <bpmn:documentation>Catalog: 06.4.4. Outcome: team cost &amp; CapEx % per team</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_06_4_5" name="Allocate team costs to work or towers">
      <bpmn:documentation>Catalog: 06.4.5. Outcome: work-attached &amp; tower-attached labor costs</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_06_4_6" name="Generate audit-ready capitalization actuals">
      <bpmn:documentation>Catalog: 06.4.6. Outcome: sAP-ready CapEx/OpEx actuals file</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_06_4_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_06_4_1" targetRef="n_06_4_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_06_4_2" targetRef="n_06_4_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_06_4_3" targetRef="n_06_4_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_06_4_4" targetRef="n_06_4_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="n_06_4_5" targetRef="n_06_4_6" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="n_06_4_6" targetRef="n_end_implicit" />
  </bpmn:process>
