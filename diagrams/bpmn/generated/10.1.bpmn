  <bpmn:collaboration id="Collaboration_G10_1">
    <bpmn:participant id="Participant_G10_1" name="10.1 Configure Targetprocess — Configure Targetprocess" processRef="Process_G10_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G10_1" name="Configure Targetprocess" isExecutable="false">
    <bpmn:documentation>Process group 10.1 in L0-10 Platform Configuration, Data &amp; Administration: 5 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G10_1">
      <bpmn:lane id="Lane_G10_1_0" name="Platform Admins">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_1_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_1_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_1_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_1_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_1_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_10_1_1" name="Design org, portfolio &amp; team structure">
      <bpmn:documentation>Catalog: 10.1.1. Outcome: configured structure</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_10_1_2" name="Configure processes, workflows &amp; fields">
      <bpmn:documentation>Catalog: 10.1.2. Outcome: configured processes</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_10_1_3" name="Install &amp; tailor Solution Library packages">
      <bpmn:documentation>Catalog: 10.1.3. Outcome: installed, tailored solutions</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="n_10_1_4" name="Build views, dashboards &amp; automation">
      <bpmn:documentation>Catalog: 10.1.4. Outcome: role-based UX &amp; automations</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="n_10_1_5" name="Manage integrations &amp; environments">
      <bpmn:documentation>Catalog: 10.1.5. Outcome: working integrations, promoted config</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_10_1_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_10_1_1" targetRef="n_10_1_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_10_1_2" targetRef="n_10_1_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_10_1_3" targetRef="n_10_1_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_10_1_4" targetRef="n_10_1_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="n_10_1_5" targetRef="n_end_implicit" />
  </bpmn:process>
