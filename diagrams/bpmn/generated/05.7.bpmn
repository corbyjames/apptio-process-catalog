<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G05_7" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.7.0">
  <bpmn:collaboration id="Collaboration_G05_7">
    <bpmn:participant id="Participant_G05_7" name="05.7 Plan project &amp; investment finances — Plan project &amp; investment finances" processRef="Process_G05_7" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G05_7" name="Plan project &amp; investment finances" isExecutable="false">
    <bpmn:documentation>Process group 05.7 in L0-05 IT Financial Planning &amp; Budgeting: 3 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G05_7">
      <bpmn:lane id="Lane_G05_7_0" name="IT Finance">
        <bpmn:flowNodeRef>n_05_7_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G05_7_1" name="Budget Owners">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_05_7_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_05_7_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="n_05_7_1" name="Define investments &amp; cost treatment">
      <bpmn:documentation>Catalog: 05.7.1. Outcome: investment financial structures</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="n_05_7_2" name="Plan investment labor &amp; cross-charge">
      <bpmn:documentation>Catalog: 05.7.2. Outcome: investment labor plan</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_05_7_3" name="Operate the investment loop with ATP">
      <bpmn:documentation>Catalog: 05.7.3. Outcome: approved budgets &amp; changes (to ATP)</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_05_7_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_05_7_1" targetRef="n_05_7_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_05_7_2" targetRef="n_05_7_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_05_7_3" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G05_7">
    <bpmndi:BPMNPlane id="BPMNPlane_G05_7" bpmnElement="Collaboration_G05_7">
