  <bpmn:process id="Process_A07" name="Cloud Financial Management (FinOps)" isExecutable="false">
    <bpmn:documentation>Operate the FinOps lifecycle - ingest and allocate multi-cloud and container spend, report it, respond to anomalies, optimize usage and rates, and plan cloud budgets and migrations.</bpmn:documentation>
