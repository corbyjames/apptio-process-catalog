  <bpmn:process id="Process_A03" name="Agile Program &amp; Delivery Management" isExecutable="false">
    <bpmn:documentation>Plan and execute work on a PI and iteration cadence across ARTs, solution trains and teams, including hybrid/waterfall delivery, release management and value stream flow.</bpmn:documentation>
