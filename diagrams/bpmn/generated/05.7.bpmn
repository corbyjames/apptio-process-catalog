      <bpmndi:BPMNShape id="n_05_7_2_di" bpmnElement="n_05_7_2"><dc:Bounds x="594" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_05_7_3_di" bpmnElement="n_05_7_3"><dc:Bounds x="802" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_implicit_di" bpmnElement="n_end_implicit"><dc:Bounds x="1073" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="277" y="183" /><di:waypoint x="386" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="548" y="183" /><di:waypoint x="594" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="756" y="183" /><di:waypoint x="779" y="183" /><di:waypoint x="779" y="61" /><di:waypoint x="802" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="964" y="61" /><di:waypoint x="1073" y="61" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
