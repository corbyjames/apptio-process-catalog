<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G02_3" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G02_3">
    <bpmn:participant id="Participant_G02_3" name="02.3 Plan &amp; roadmap the portfolio — Plan &amp; roadmap the portfolio" processRef="Process_G02_3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G02_3" name="Plan &amp; roadmap the portfolio" isExecutable="false">
    <bpmn:documentation>Process group 02.3 in L0-02 Demand &amp; Portfolio Investment Management: 4 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G02_3">
      <bpmn:lane id="Lane_G02_3_0" name="Portfolio Management">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_02_3_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_02_3_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_02_3_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_02_3_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="n_02_3_1" name="Build &amp; maintain roadmaps">
      <bpmn:documentation>Catalog: 02.3.1. Outcome: multi-level roadmaps</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="n_02_3_2" name="Model scenarios &amp; trade-offs">
      <bpmn:documentation>Catalog: 02.3.2. Outcome: selected scenario/baseline</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_02_3_3" name="Manage cross-initiative dependencies &amp; risks">
      <bpmn:documentation>Catalog: 02.3.3. Outcome: dependency/risk register &amp; resolutions</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_02_3_4" name="Maintain one governed hybrid portfolio view">
      <bpmn:documentation>Catalog: 02.3.4. Outcome: unified hybrid portfolio views &amp; status</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_02_3_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_02_3_1" targetRef="n_02_3_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_02_3_2" targetRef="n_02_3_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_02_3_3" targetRef="n_02_3_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_02_3_4" targetRef="n_end_implicit" />
  </bpmn:process>
