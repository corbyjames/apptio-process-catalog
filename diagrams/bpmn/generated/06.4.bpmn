      <bpmndi:BPMNShape id="Lane_G06_4_0_di" bpmnElement="Lane_G06_4_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="2644" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G06_4_1_di" bpmnElement="Lane_G06_4_1" isHorizontal="true"><dc:Bounds x="30" y="122" width="2644" height="122" /></bpmndi:BPMNShape>
