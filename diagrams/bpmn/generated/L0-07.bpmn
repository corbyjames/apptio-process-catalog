      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_07_5" name="Optimize usage &amp; rates" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 07.5.1. 4 processes: 07.5.1, 07.5.2, 07.5.3, 07.5.4</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_07_6" name="Plan &amp; forecast cloud spend" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 07.6.1. 3 processes: 07.6.1, 07.6.2, 07.6.3</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
