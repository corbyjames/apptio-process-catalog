<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G06_2" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G06_2">
    <bpmn:participant id="Participant_G06_2" name="06.2 Analyze cost, variance &amp; investment mix — Analyze cost, variance &amp; investment mix" processRef="Process_G06_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G06_2" name="Analyze cost, variance &amp; investment mix" isExecutable="false">
    <bpmn:documentation>Process group 06.2 in L0-06 Cost Transparency &amp; TBM Operations: 3 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G06_2">
      <bpmn:lane id="Lane_G06_2_0" name="TBM Office/IT Finance">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_2_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_06_2_1" name="Analyze spend by cost pool &amp; tower">
      <bpmn:documentation>Catalog: 06.2.1. Outcome: spend insights, unit costs</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_06_2_2" name="Track budget vs actuals in the model">
      <bpmn:documentation>Catalog: 06.2.2. Outcome: variance reporting</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_06_2_3" name="Classify &amp; report run/grow/transform">
      <bpmn:documentation>Catalog: 06.2.3. Outcome: investment mix reporting</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_06_2_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_06_2_1" targetRef="n_06_2_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_06_2_2" targetRef="n_06_2_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_06_2_3" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G06_2">
    <bpmndi:BPMNPlane id="BPMNPlane_G06_2" bpmnElement="Collaboration_G06_2">
      <bpmndi:BPMNShape id="Participant_G06_2_di" bpmnElement="Participant_G06_2" isHorizontal="true"><dc:Bounds x="0" y="0" width="1218" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G06_2_0_di" bpmnElement="Lane_G06_2_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="1188" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_implicit_di" bpmnElement="n_start_implicit"><dc:Bounds x="241" y="43" width="36" height="36" /></bpmndi:BPMNShape>
