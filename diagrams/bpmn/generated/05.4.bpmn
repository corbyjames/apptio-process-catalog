<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G05_4" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G05_4">
    <bpmn:participant id="Participant_G05_4" name="05.4 Plan workforce &amp; labor cost — Plan workforce &amp; labor cost" processRef="Process_G05_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G05_4" name="Plan workforce &amp; labor cost" isExecutable="false">
    <bpmn:documentation>Process group 05.4 in L0-05 IT Financial Planning &amp; Budgeting: 3 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G05_4">
      <bpmn:lane id="Lane_G05_4_0" name="IT Finance">
        <bpmn:flowNodeRef>n_05_4_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_05_4_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G05_4_1" name="Budget Owners">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_05_4_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_05_4_1" name="Plan positions &amp; FTEs">
      <bpmn:documentation>Catalog: 05.4.1. Outcome: position-level labor plan (open + filled)</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_05_4_2" name="Plan compensation &amp; adjustments">
      <bpmn:documentation>Catalog: 05.4.2. Outcome: labor cost plan</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_05_4_3" name="Allocate planned labor">
      <bpmn:documentation>Catalog: 05.4.3. Outcome: allocated labor plan</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_05_4_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_05_4_1" targetRef="n_05_4_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_05_4_2" targetRef="n_05_4_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_05_4_3" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G05_4">
    <bpmndi:BPMNPlane id="BPMNPlane_G05_4" bpmnElement="Collaboration_G05_4">
      <bpmndi:BPMNShape id="Participant_G05_4_di" bpmnElement="Participant_G05_4" isHorizontal="true"><dc:Bounds x="0" y="0" width="1218" height="244" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G05_4_0_di" bpmnElement="Lane_G05_4_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="1188" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G05_4_1_di" bpmnElement="Lane_G05_4_1" isHorizontal="true"><dc:Bounds x="30" y="122" width="1188" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_implicit_di" bpmnElement="n_start_implicit"><dc:Bounds x="241" y="165" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_05_4_1_di" bpmnElement="n_05_4_1"><dc:Bounds x="386" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_05_4_2_di" bpmnElement="n_05_4_2"><dc:Bounds x="594" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_05_4_3_di" bpmnElement="n_05_4_3"><dc:Bounds x="802" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_implicit_di" bpmnElement="n_end_implicit"><dc:Bounds x="1073" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="277" y="183" /><di:waypoint x="386" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="548" y="183" /><di:waypoint x="571" y="183" /><di:waypoint x="571" y="61" /><di:waypoint x="594" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="756" y="61" /><di:waypoint x="802" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="964" y="61" /><di:waypoint x="1073" y="61" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
