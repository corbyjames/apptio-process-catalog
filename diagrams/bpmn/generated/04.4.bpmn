<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G04_4" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G04_4">
    <bpmn:participant id="Participant_G04_4" name="04.4 Manage positions — Manage positions" processRef="Process_G04_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G04_4" name="Manage positions" isExecutable="false">
    <bpmn:documentation>Process group 04.4 in L0-04 Workforce &amp; Resource Management: 3 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G04_4">
      <bpmn:lane id="Lane_G04_4_0" name="Portfolio Management">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_04_4_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G04_4_1" name="HR/Approvers">
        <bpmn:flowNodeRef>n_04_4_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G04_4_2" name="Finance (IT Planning)">
        <bpmn:flowNodeRef>n_04_4_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="n_04_4_1" name="Create position requests">
      <bpmn:documentation>Catalog: 04.4.1. Outcome: position request records</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_04_4_2" name="Approve positions (multi-level workflow)">
      <bpmn:documentation>Catalog: 04.4.2. Outcome: approved/rejected positions</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="n_04_4_3" name="Sync approved positions to Planning &amp; auto-update on fill">
      <bpmn:documentation>Catalog: 04.4.3. Outcome: budgeted open+filled positions, auto-updated</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_04_4_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_04_4_1" targetRef="n_04_4_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_04_4_2" targetRef="n_04_4_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_04_4_3" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G04_4">
    <bpmndi:BPMNPlane id="BPMNPlane_G04_4" bpmnElement="Collaboration_G04_4">
      <bpmndi:BPMNShape id="Participant_G04_4_di" bpmnElement="Participant_G04_4" isHorizontal="true"><dc:Bounds x="0" y="0" width="1218" height="366" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G04_4_0_di" bpmnElement="Lane_G04_4_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="1188" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G04_4_1_di" bpmnElement="Lane_G04_4_1" isHorizontal="true"><dc:Bounds x="30" y="122" width="1188" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G04_4_2_di" bpmnElement="Lane_G04_4_2" isHorizontal="true"><dc:Bounds x="30" y="244" width="1188" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_implicit_di" bpmnElement="n_start_implicit"><dc:Bounds x="241" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_04_4_1_di" bpmnElement="n_04_4_1"><dc:Bounds x="386" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_04_4_2_di" bpmnElement="n_04_4_2"><dc:Bounds x="594" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_04_4_3_di" bpmnElement="n_04_4_3"><dc:Bounds x="802" y="268" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_implicit_di" bpmnElement="n_end_implicit"><dc:Bounds x="1073" y="287" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="277" y="61" /><di:waypoint x="386" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="548" y="61" /><di:waypoint x="571" y="61" /><di:waypoint x="571" y="183" /><di:waypoint x="594" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="756" y="183" /><di:waypoint x="779" y="183" /><di:waypoint x="779" y="305" /><di:waypoint x="802" y="305" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="964" y="305" /><di:waypoint x="1073" y="305" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
