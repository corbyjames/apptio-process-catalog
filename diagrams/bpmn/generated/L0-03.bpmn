      <bpmn:lane id="Lane_A03_1" name="Agile Teams">
        <bpmn:flowNodeRef>n_03_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="n_03_1" name="Plan quarterly (SAFe PI cadence)" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 03.1.1. 6 processes: 03.1.1, 03.1.2, 03.1.3, 03.1.4, 03.1.5, 03.1.6</bpmn:documentation>
