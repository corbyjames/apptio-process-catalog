<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G07_3" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G07_3">
    <bpmn:participant id="Participant_G07_3" name="07.3 Report cloud cost, unit economics &amp; sustainability — Report cloud cost, unit economics &amp; sustainability" processRef="Process_G07_3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G07_3" name="Report cloud cost, unit economics &amp; sustainability" isExecutable="false">
    <bpmn:documentation>Process group 07.3 in L0-07 Cloud Financial Management (FinOps): 4 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G07_3">
      <bpmn:lane id="Lane_G07_3_0" name="FinOps Practitioner">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_07_3_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_07_3_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_07_3_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_07_3_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_07_3_1" name="Operate dashboards &amp; scheduled reports">
      <bpmn:documentation>Catalog: 07.3.1. Outcome: self-service visibility</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_07_3_2" name="Benchmark efficiency">
      <bpmn:documentation>Catalog: 07.3.2. Outcome: scorecards</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_07_3_3" name="Track unit economics">
      <bpmn:documentation>Catalog: 07.3.3. Outcome: unit cost trends</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_07_3_4" name="Report &amp; act on sustainability">
      <bpmn:documentation>Catalog: 07.3.4. Outcome: sustainability reporting</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_07_3_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_07_3_1" targetRef="n_07_3_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_07_3_2" targetRef="n_07_3_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_07_3_3" targetRef="n_07_3_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_07_3_4" targetRef="n_end_implicit" />
  </bpmn:process>
