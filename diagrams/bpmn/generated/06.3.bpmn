<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G06_3" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G06_3">
    <bpmn:participant id="Participant_G06_3" name="06.3 Compute application &amp; service TCO — Compute application &amp; service TCO" processRef="Process_G06_3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G06_3" name="Compute application &amp; service TCO" isExecutable="false">
    <bpmn:documentation>Process group 06.3 in L0-06 Cost Transparency &amp; TBM Operations: 4 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G06_3">
      <bpmn:lane id="Lane_G06_3_0" name="TBM Office/IT Finance">
        <bpmn:flowNodeRef>n_06_3_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_3_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G06_3_1" name="App/Service Owners">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_3_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_3_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_06_3_1" name="Maintain application &amp; service inventory">
      <bpmn:documentation>Catalog: 06.3.1. Outcome: governed app/service master data</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_06_3_2" name="Allocate costs to applications &amp; services">
      <bpmn:documentation>Catalog: 06.3.2. Outcome: app/service costs (fully burdened)</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_06_3_3" name="Report &amp; act on App TCO">
      <bpmn:documentation>Catalog: 06.3.3. Outcome: tCO reports, rationalization actions</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_06_3_4" name="Compute service unit costs">
      <bpmn:documentation>Catalog: 06.3.4. Outcome: service unit costs</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_06_3_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_06_3_1" targetRef="n_06_3_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_06_3_2" targetRef="n_06_3_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_06_3_3" targetRef="n_06_3_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_06_3_4" targetRef="n_end_implicit" />
  </bpmn:process>
