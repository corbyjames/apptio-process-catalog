<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G06_1" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G06_1">
    <bpmn:participant id="Participant_G06_1" name="06.1 Run the monthly allocation &amp; close — Run the monthly allocation &amp; close" processRef="Process_G06_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G06_1" name="Run the monthly allocation &amp; close" isExecutable="false">
    <bpmn:documentation>Process group 06.1 in L0-06 Cost Transparency &amp; TBM Operations: 4 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G06_1">
      <bpmn:lane id="Lane_G06_1_0" name="TBM Office/IT Finance">
        <bpmn:flowNodeRef>n_06_1_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_1_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_1_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G06_1_1" name="Costing Admin">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_1_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="n_06_1_1" name="Load month-end actuals">
      <bpmn:documentation>Catalog: 06.1.1. Outcome: loaded period data</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_06_1_2" name="Refresh mappings &amp; run allocations">
      <bpmn:documentation>Catalog: 06.1.2. Outcome: allocated cost model for period</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="n_06_1_3" name="Validate &amp; reconcile to GL">
      <bpmn:documentation>Catalog: 06.1.3. Outcome: validated, reconciled model</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_06_1_4" name="Publish monthly TBM reporting">
      <bpmn:documentation>Catalog: 06.1.4. Outcome: published dashboards/reports</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_06_1_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_06_1_1" targetRef="n_06_1_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_06_1_2" targetRef="n_06_1_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_06_1_3" targetRef="n_06_1_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_06_1_4" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G06_1">
    <bpmndi:BPMNPlane id="BPMNPlane_G06_1" bpmnElement="Collaboration_G06_1">
      <bpmndi:BPMNShape id="Participant_G06_1_di" bpmnElement="Participant_G06_1" isHorizontal="true"><dc:Bounds x="0" y="0" width="1426" height="244" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G06_1_0_di" bpmnElement="Lane_G06_1_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="1396" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G06_1_1_di" bpmnElement="Lane_G06_1_1" isHorizontal="true"><dc:Bounds x="30" y="122" width="1396" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_implicit_di" bpmnElement="n_start_implicit"><dc:Bounds x="241" y="165" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_06_1_1_di" bpmnElement="n_06_1_1"><dc:Bounds x="386" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_06_1_2_di" bpmnElement="n_06_1_2"><dc:Bounds x="594" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_06_1_3_di" bpmnElement="n_06_1_3"><dc:Bounds x="802" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_06_1_4_di" bpmnElement="n_06_1_4"><dc:Bounds x="1010" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_implicit_di" bpmnElement="n_end_implicit"><dc:Bounds x="1281" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="277" y="183" /><di:waypoint x="386" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="548" y="183" /><di:waypoint x="571" y="183" /><di:waypoint x="571" y="61" /><di:waypoint x="594" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="756" y="61" /><di:waypoint x="802" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="964" y="61" /><di:waypoint x="1010" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="1172" y="61" /><di:waypoint x="1281" y="61" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
