  <bpmn:collaboration id="Collaboration_G03_2">
    <bpmn:participant id="Participant_G03_2" name="03.2 Deliver at team level — Deliver at team level" processRef="Process_G03_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G03_2" name="Deliver at team level" isExecutable="false">
    <bpmn:documentation>Process group 03.2 in L0-03 Agile Program &amp; Delivery Management: 4 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G03_2">
      <bpmn:lane id="Lane_G03_2_0" name="Agile Teams">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_2_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_2_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_03_2_1" name="Plan &amp; execute iterations">
      <bpmn:documentation>Catalog: 03.2.1. Outcome: working increments, updated states</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_03_2_2" name="Track flow &amp; progress">
      <bpmn:documentation>Catalog: 03.2.2. Outcome: flow metrics, forecasts</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_03_2_3" name="Manage impediments &amp; dependencies">
      <bpmn:documentation>Catalog: 03.2.3. Outcome: resolved blockers</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="n_03_2_4" name="Sync with dev tools">
      <bpmn:documentation>Catalog: 03.2.4. Outcome: unified hierarchy over team tools</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_03_2_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_03_2_1" targetRef="n_03_2_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_03_2_2" targetRef="n_03_2_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_03_2_3" targetRef="n_03_2_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_03_2_4" targetRef="n_end_implicit" />
  </bpmn:process>
