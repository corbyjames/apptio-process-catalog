  <bpmn:collaboration id="Collaboration_G10_4">
    <bpmn:participant id="Participant_G10_4" name="10.4 Configure Cloudability — Configure Cloudability" processRef="Process_G10_4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G10_4" name="Configure Cloudability" isExecutable="false">
    <bpmn:documentation>Process group 10.4 in L0-10 Platform Configuration, Data &amp; Administration: 2 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G10_4">
      <bpmn:lane id="Lane_G10_4_0" name="Platform Admins">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_4_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_4_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_10_4_1" name="Configure cloud data, mappings &amp; views">
      <bpmn:documentation>Catalog: 10.4.1. Outcome: allocated, view-scoped cloud cost data</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_10_4_2" name="Configure budgets, alerts, optimization &amp; governance">
      <bpmn:documentation>Catalog: 10.4.2. Outcome: tuned FinOps operating controls</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_10_4_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_10_4_1" targetRef="n_10_4_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_10_4_2" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G10_4">
    <bpmndi:BPMNPlane id="BPMNPlane_G10_4" bpmnElement="Collaboration_G10_4">
