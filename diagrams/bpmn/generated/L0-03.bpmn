      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_03_2" name="Deliver at team level" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 03.2.1. 4 processes: 03.2.1, 03.2.2, 03.2.3, 03.2.4</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_03_3" name="Manage releases &amp; hybrid projects" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 03.3.1. 3 processes: 03.3.1, 03.3.2, 03.3.3</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_03_4" name="Manage value streams" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 03.4.1. 2 processes: 03.4.1, 03.4.2</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
