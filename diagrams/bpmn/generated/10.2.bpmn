<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G10_2" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.6.0">
  <bpmn:collaboration id="Collaboration_G10_2">
    <bpmn:participant id="Participant_G10_2" name="10.2 Configure Costing — Configure Costing" processRef="Process_G10_2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G10_2" name="Configure Costing" isExecutable="false">
    <bpmn:documentation>Process group 10.2 in L0-10 Platform Configuration, Data &amp; Administration: 2 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G10_2">
      <bpmn:lane id="Lane_G10_2_0" name="Platform Admins">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_2_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_10_2_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_10_2_1" name="Implement the cost model">
      <bpmn:documentation>Catalog: 10.2.1. Outcome: working TBM model</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="n_10_2_2" name="Operate data pipelines (Datalink)">
      <bpmn:documentation>Catalog: 10.2.2. Outcome: reliable automated feeds (5-15 sources)</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_10_2_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_10_2_1" targetRef="n_10_2_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_10_2_2" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G10_2">
    <bpmndi:BPMNPlane id="BPMNPlane_G10_2" bpmnElement="Collaboration_G10_2">
      <bpmndi:BPMNShape id="Participant_G10_2_di" bpmnElement="Participant_G10_2" isHorizontal="true"><dc:Bounds x="0" y="0" width="1010" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G10_2_0_di" bpmnElement="Lane_G10_2_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="980" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_implicit_di" bpmnElement="n_start_implicit"><dc:Bounds x="241" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_10_2_1_di" bpmnElement="n_10_2_1"><dc:Bounds x="386" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_10_2_2_di" bpmnElement="n_10_2_2"><dc:Bounds x="594" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_implicit_di" bpmnElement="n_end_implicit"><dc:Bounds x="865" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="277" y="61" /><di:waypoint x="386" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="548" y="61" /><di:waypoint x="594" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="756" y="61" /><di:waypoint x="865" y="61" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
