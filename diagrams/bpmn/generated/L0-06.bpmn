  <bpmn:collaboration id="Collaboration_A06">
    <bpmn:participant id="Participant_A06" name="L0-06 Cost Transparency &amp; TBM Operations — Cost Transparency &amp; TBM Operations" processRef="Process_A06" />
  </bpmn:collaboration>
  <bpmn:process id="Process_A06" name="Cost Transparency &amp; TBM Operations" isExecutable="false">
    <bpmn:documentation>Run the monthly TBM engine: ingest actuals, allocate costs through cost pools and towers to applications, services and business units, cost labor defensibly, and analyze TCO.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_A06">
      <bpmn:lane id="Lane_A06_0" name="TBM Office/IT Finance">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_06_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="n_06_1" name="Run the monthly allocation &amp; close" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 06.1.1. 4 processes: 06.1.1, 06.1.2, 06.1.3, 06.1.4</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_06_2" name="Analyze cost, variance &amp; investment mix" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 06.2.1. 3 processes: 06.2.1, 06.2.2, 06.2.3</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_06_3" name="Compute application &amp; service TCO" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 06.3.1. 4 processes: 06.3.1, 06.3.2, 06.3.3, 06.3.4</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_06_4" name="Cost labor &amp; capitalize" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 06.4.1. 6 processes: 06.4.1, 06.4.2, 06.4.3, 06.4.4, 06.4.5, 06.4.6</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_06_5" name="Manage vendor &amp; asset cost" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 06.5.1. 2 processes: 06.5.1, 06.5.2</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:subProcess id="n_06_6" name="Benchmark against peers" triggeredByEvent="false">
      <bpmn:documentation>Catalog: 06.6.1. 2 processes: 06.6.1, 06.6.2</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_06_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_06_1" targetRef="n_06_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_06_2" targetRef="n_06_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_06_3" targetRef="n_06_4" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="n_06_4" targetRef="n_06_5" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="n_06_5" targetRef="n_06_6" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="n_06_6" targetRef="n_end_implicit" />
  </bpmn:process>
