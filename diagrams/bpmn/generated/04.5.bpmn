<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G04_5" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.7.0">
  <bpmn:collaboration id="Collaboration_G04_5">
    <bpmn:participant id="Participant_G04_5" name="04.5 Track &amp; approve time — Track &amp; approve time" processRef="Process_G04_5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G04_5" name="Track &amp; approve time" isExecutable="false">
    <bpmn:documentation>Process group 04.5 in L0-04 Workforce &amp; Resource Management: 3 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G04_5">
      <bpmn:lane id="Lane_G04_5_0" name="Resource Management">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_04_5_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_04_5_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_G04_5_1" name="Finance (IT Planning)">
        <bpmn:flowNodeRef>n_04_5_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="n_04_5_1" name="Capture effort against work">
      <bpmn:documentation>Catalog: 04.5.1. Outcome: time entries / effort data 5 approaches on record (see catalog variants).</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="n_04_5_2" name="Approve timesheets">
      <bpmn:documentation>Catalog: 04.5.2. Outcome: approved time Only when Labor effort signal: Timesheets (hours x rate). 1 approaches on record (see catalog variants).</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="n_04_5_3" name="Feed time/effort to finance processes">
      <bpmn:documentation>Catalog: 04.5.3. Outcome: effort data for costing &amp; CapEx 5 approaches on record (see catalog variants).</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_04_5_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_04_5_1" targetRef="n_04_5_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_04_5_2" targetRef="n_04_5_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_04_5_3" targetRef="n_end_implicit" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_G04_5">
    <bpmndi:BPMNPlane id="BPMNPlane_G04_5" bpmnElement="Collaboration_G04_5">
      <bpmndi:BPMNShape id="Participant_G04_5_di" bpmnElement="Participant_G04_5" isHorizontal="true"><dc:Bounds x="0" y="0" width="1218" height="244" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G04_5_0_di" bpmnElement="Lane_G04_5_0" isHorizontal="true"><dc:Bounds x="30" y="0" width="1188" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_G04_5_1_di" bpmnElement="Lane_G04_5_1" isHorizontal="true"><dc:Bounds x="30" y="122" width="1188" height="122" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_implicit_di" bpmnElement="n_start_implicit"><dc:Bounds x="241" y="43" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_04_5_1_di" bpmnElement="n_04_5_1"><dc:Bounds x="386" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_04_5_2_di" bpmnElement="n_04_5_2"><dc:Bounds x="594" y="24" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_04_5_3_di" bpmnElement="n_04_5_3"><dc:Bounds x="802" y="146" width="162" height="74" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_implicit_di" bpmnElement="n_end_implicit"><dc:Bounds x="1073" y="165" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0_di" bpmnElement="Flow_0"><di:waypoint x="277" y="61" /><di:waypoint x="386" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="548" y="61" /><di:waypoint x="594" y="61" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="756" y="61" /><di:waypoint x="779" y="61" /><di:waypoint x="779" y="183" /><di:waypoint x="802" y="183" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="964" y="183" /><di:waypoint x="1073" y="183" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
