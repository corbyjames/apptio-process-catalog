<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ApptioE2E" targetNamespace="http://cprime.com/apptio-e2e" exporter="Claude" exporterVersion="2.0">
<bpmn:category id="Cat_uc3"><bpmn:categoryValue id="CatVal_uc3" value="UC3 — Portfolio Target Spend: IT Planning → ATP (incl. position management)" /></bpmn:category>
<bpmn:category id="Cat_uc2"><bpmn:categoryValue id="CatVal_uc2" value="UC2 — Work Allocations: Rates back to ATP from Costing" /></bpmn:category>
<bpmn:category id="Cat_uc1"><bpmn:categoryValue id="CatVal_uc1" value="UC1 — Labor Capitalization: ATP → Costing" /></bpmn:category>
<bpmn:category id="Cat_uc4"><bpmn:categoryValue id="CatVal_uc4" value="UC4 — Cost Actuals up to App TCO" /></bpmn:category>
<bpmn:collaboration id="Collab_1">
<bpmn:participant id="Pool_Apptio" name="Apptio Platform — End-to-End Flow, 4 Use Cases (Cprime for MetLife)" processRef="Proc_E2E" />
</bpmn:collaboration>
<bpmn:process id="Proc_E2E" isExecutable="false">
<bpmn:laneSet id="LaneSet_1">
<bpmn:lane id="Lane_itp" name="IT Planning (Finance)">
<bpmn:flowNodeRef>start1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_wfp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_send1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_norm</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_tp" name="Targetprocess / ATP (Portfolio &amp; Workforce Mgmt)">
<bpmn:flowNodeRef>t_bud</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_pos</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_appr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g_appr</bpmn:flowNodeRef>
<bpmn:flowNodeRef>e_rej</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_send2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_alloc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_cmp</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_costwa</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_data</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_send3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_cost" name="Costing — Apptio One / TBM Studio">
<bpmn:flowNodeRef>t_rates</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_send4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_calc</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g_vis</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_work</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_tower</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g_join</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_sap</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_tco</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t_run</bpmn:flowNodeRef>
<bpmn:flowNodeRef>end1</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="start1" name="Planning cycle begins">
<bpmn:outgoing>flow_0</bpmn:outgoing>
</bpmn:startEvent>
<bpmn:task id="t_wfp" name="Create workforce plan &amp; top-down target spend by department">
<bpmn:incoming>flow_0</bpmn:incoming>
<bpmn:outgoing>flow_1</bpmn:outgoing>
</bpmn:task>
<bpmn:sendTask id="t_send1" name="Send portfolio spend targets to ATP (data highway)">
<bpmn:incoming>flow_1</bpmn:incoming>
<bpmn:outgoing>flow_2</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:task id="t_bud" name="Create top-down budget / target artifacts">
<bpmn:incoming>flow_2</bpmn:incoming>
<bpmn:outgoing>flow_3</bpmn:outgoing>
</bpmn:task>
<bpmn:userTask id="t_pos" name="Create position request (role, location, hours, type)">
<bpmn:incoming>flow_3</bpmn:incoming>
<bpmn:outgoing>flow_4</bpmn:outgoing>
</bpmn:userTask>
<bpmn:userTask id="t_appr" name="Run multi-level approval workflow (HR → Dept → Final, escalations)">
<bpmn:incoming>flow_4</bpmn:incoming>
<bpmn:outgoing>flow_5</bpmn:outgoing>
</bpmn:userTask>
<bpmn:exclusiveGateway id="g_appr" name="Approved?">
<bpmn:incoming>flow_5</bpmn:incoming>
<bpmn:outgoing>flow_6</bpmn:outgoing>
<bpmn:outgoing>flow_7</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:endEvent id="e_rej" name="Request rejected">
<bpmn:incoming>flow_6</bpmn:incoming>
</bpmn:endEvent>
<bpmn:sendTask id="t_send2" name="Send approved positions to IT Planning (daily / weekly sync)">
<bpmn:incoming>flow_7</bpmn:incoming>
<bpmn:outgoing>flow_8</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:task id="t_norm" name="Normalize &amp; budget open + filled positions (auto-updated when filled)">
<bpmn:incoming>flow_8</bpmn:incoming>
<bpmn:outgoing>flow_9</bpmn:outgoing>
</bpmn:task>
<bpmn:userTask id="t_alloc" name="Allocate users / teams / ARTs / solution trains to work (bottom-up demand)">
<bpmn:incoming>flow_9</bpmn:incoming>
<bpmn:outgoing>flow_10</bpmn:outgoing>
</bpmn:userTask>
<bpmn:task id="t_cmp" name="Compare demand rollup vs. target spend (capacity / FTE reports)">
<bpmn:incoming>flow_10</bpmn:incoming>
<bpmn:outgoing>flow_11</bpmn:outgoing>
</bpmn:task>
<bpmn:serviceTask id="t_rates" name="Maintain protected rates; compute blended team / ART-level rates">
<bpmn:incoming>flow_11</bpmn:incoming>
<bpmn:outgoing>flow_12</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:sendTask id="t_send4" name="Send blended rates back to ATP (Costing is source of truth)">
<bpmn:incoming>flow_12</bpmn:incoming>
<bpmn:outgoing>flow_13</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:task id="t_costwa" name="Cost work allocations with blended rates; feed budget cycle">
<bpmn:incoming>flow_13</bpmn:incoming>
<bpmn:outgoing>flow_14</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t_data" name="Maintain involvements %, job profiles, CapEx/OpEx &amp; IT-tower mappings">
<bpmn:incoming>flow_14</bpmn:incoming>
<bpmn:outgoing>flow_15</bpmn:outgoing>
</bpmn:task>
<bpmn:sendTask id="t_send3" name="Send workforce &amp; completed work data to Costing (TBM Studio)">
<bpmn:incoming>flow_15</bpmn:incoming>
<bpmn:outgoing>flow_16</bpmn:outgoing>
</bpmn:sendTask>
<bpmn:serviceTask id="t_calc" name="Calculate monthly team cost &amp; blended CapEx % (protected rates)">
<bpmn:incoming>flow_16</bpmn:incoming>
<bpmn:outgoing>flow_17</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:exclusiveGateway id="g_vis" name="Team work visible?">
<bpmn:incoming>flow_17</bpmn:incoming>
<bpmn:outgoing>flow_18</bpmn:outgoing>
<bpmn:outgoing>flow_19</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:task id="t_work" name="Allocate team costs to completed work (story points, weightage)">
<bpmn:incoming>flow_18</bpmn:incoming>
<bpmn:outgoing>flow_20</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t_tower" name="Allocate team costs to IT towers / apps (fixed capacity)">
<bpmn:incoming>flow_19</bpmn:incoming>
<bpmn:outgoing>flow_21</bpmn:outgoing>
</bpmn:task>
<bpmn:exclusiveGateway id="g_join" name="">
<bpmn:incoming>flow_20</bpmn:incoming>
<bpmn:incoming>flow_21</bpmn:incoming>
<bpmn:outgoing>flow_22</bpmn:outgoing>
</bpmn:exclusiveGateway>
<bpmn:serviceTask id="t_sap" name="Generate SAP-ready monthly actuals — CapEx / OpEx by user (deprecates time writing)">
<bpmn:incoming>flow_22</bpmn:incoming>
<bpmn:outgoing>flow_23</bpmn:outgoing>
</bpmn:serviceTask>
<bpmn:task id="t_tco" name="Roll cost actuals up to Application TCO">
<bpmn:incoming>flow_23</bpmn:incoming>
<bpmn:outgoing>flow_24</bpmn:outgoing>
</bpmn:task>
<bpmn:task id="t_run" name="Attribute labor cost to run vs. change in App TCO view">
<bpmn:incoming>flow_24</bpmn:incoming>
<bpmn:outgoing>flow_25</bpmn:outgoing>
</bpmn:task>
<bpmn:endEvent id="end1" name="Finance &amp; App TCO reporting">
<bpmn:incoming>flow_25</bpmn:incoming>
</bpmn:endEvent>
<bpmn:group id="Group_uc3" categoryValueRef="CatVal_uc3" />
