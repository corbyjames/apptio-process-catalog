<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_G03_3" targetNamespace="urn:apptio:process-catalog" exporter="Apptio Process Catalog" exporterVersion="0.7.0">
  <bpmn:collaboration id="Collaboration_G03_3">
    <bpmn:participant id="Participant_G03_3" name="03.3 Manage releases &amp; hybrid projects — Manage releases &amp; hybrid projects" processRef="Process_G03_3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_G03_3" name="Manage releases &amp; hybrid projects" isExecutable="false">
    <bpmn:documentation>Process group 03.3 in L0-03 Agile Program &amp; Delivery Management: 3 L2 processes laid out in the order of the catalog, in the BPMN lane of the persona that performs each one.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_G03_3">
      <bpmn:lane id="Lane_G03_3_0" name="RTE/Program">
        <bpmn:flowNodeRef>n_start_implicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_3_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_3_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_03_3_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_implicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start_implicit" name="">
      <bpmn:outgoing>Flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="n_03_3_1" name="Plan releases &amp; enable release packages">
      <bpmn:documentation>Catalog: 03.3.1. Outcome: release plans</bpmn:documentation>
      <bpmn:incoming>Flow_0</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_03_3_2" name="Manage hybrid &amp; waterfall projects">
      <bpmn:documentation>Catalog: 03.3.2. Outcome: project plans &amp; status</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="n_03_3_3" name="Govern stage-gates &amp; milestones for traditional initiatives">
      <bpmn:documentation>Catalog: 03.3.3. Outcome: gate decisions, milestone status Only when Investment approval governance: Stage-gate / Hybrid.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="n_end_implicit" name="">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0" sourceRef="n_start_implicit" targetRef="n_03_3_1" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="n_03_3_1" targetRef="n_03_3_2" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="n_03_3_2" targetRef="n_03_3_3" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="n_03_3_3" targetRef="n_end_implicit" />
  </bpmn:process>
